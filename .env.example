# Set values in your shell or host configuration; .env is not auto-loaded.
AZURE_AI_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_RESOURCE_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com
DECISION_DEPLOYMENT=Decision-1
# Set cli locally; omit on the managed-identity host.
AZURE_CREDENTIAL_MODE=cli
EVALUATORS_CONFIG=examples/rubrics.json
# Required: supply from your host/secret store, never commit it.
# EVALUATOR_API_KEY=
