# Copy values into your shell or a secret store; .env is not auto-loaded.
AZURE_AI_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_RESOURCE_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com
DECISION_DEPLOYMENT=Decision-1
# cli for an existing az login; default for managed identity/DefaultAzureCredential.
AZURE_CREDENTIAL_MODE=cli
# Supply an existing secret through your host/secret store for non-loopback hosting.
# EVALUATOR_API_KEY=
